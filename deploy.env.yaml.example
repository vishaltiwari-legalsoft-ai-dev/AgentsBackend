# Cloud Run environment variables.
# Copy to `deploy.env.yaml`, fill in real values, and deploy with:
#   gcloud run deploy agentsbackend --source . --region us-central1 --env-vars-file deploy.env.yaml ...
# A YAML file avoids comma-escaping issues that --set-env-vars has.
#
# NOTE: Do NOT set GOOGLE_APPLICATION_CREDENTIALS here — Cloud Run uses the
# attached service account automatically. Do NOT set BRAND_KITS_DIR (ingestion
# is a local-only task; prod reads the data already in Firestore/GCS).

# "production" keeps raw exception text (file paths, doc ids, provider error
# bodies) out of API responses. Set it explicitly so /api/health reports the
# truth; only a local .env should ever say "development".
APP_ENV: "production"

OPENROUTER_API_KEY: "sk-or-v1-..."
OPENROUTER_MODEL: "anthropic/claude-sonnet-4.5"
OPENROUTER_IMAGE_MODEL: "google/gemini-3-pro-image-preview"
OPENROUTER_VISION_MODEL: "openai/gpt-4o-mini"

GCP_PROJECT_ID: "helpful-charmer-498509-v5"
GCS_BUCKET_NAME: "ls_agent_team"
FIRESTORE_DATABASE: "lsbrandkit"

JWT_SECRET: "<your 96-char secret>"
JWT_EXPIRES_MINUTES: "10080"
GOOGLE_CLIENT_ID: "255561670915-...apps.googleusercontent.com"
ADMIN_EMAILS: "vishal.tiwari@Legalsoft.com"

# Who may sign in at all. This service is deployed --allow-unauthenticated, so
# without it any Google account on the internet gets a 7-day token and reaches
# every endpoint (and the LLM billing). Empty = owners only, never "everyone".
ALLOWED_EMAIL_DOMAINS: "legalsoft.com"
# Exceptions outside those domains (contractors, clients), comma-separated.
ALLOWED_EMAILS: ""

# Set these to your Vercel URL AFTER the frontend is deployed (see steps).
APP_PUBLIC_URL: "https://your-app.vercel.app"
CORS_ORIGINS: "https://your-app.vercel.app"

# --- Marketing Research agent (a6) ---
# Multi-sheet support (connect extra Google Sheets by pasted link) is ON unless
# this says otherwise: the code defaults to "1", so leaving it out enables it.
# Set to "0" to turn off POST/DELETE /api/mr/sources and every read of a
# secondary workbook; already-connected sheets are kept, just not read.
# See backend/.env.example for the full note.
# MR_MULTI_SHEET: "1"
# Whose workspace the nightly sheet-pull cron runs as (unset = pull skipped).
# MR_CRON_USER_ID: ""

# Optional — only if using Canva in production:
# CANVA_CLIENT_ID: "..."
# CANVA_CLIENT_SECRET: "..."
# CANVA_REDIRECT_URI: "https://YOUR-BACKEND.run.app/api/canva/callback"
