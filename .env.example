# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
# "production" (the default when unset) or "development". Only "development"
# lets the API return raw exception text to the browser — never set it in prod.
APP_ENV=development
PORT=8080
# Comma-separated browser origins allowed to call this API (your Vercel URL).
# Comma-separated browser origins. Include every frontend you run locally.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=10080
# Google OAuth Web Client ID (same value as the frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Comma-separated emails granted the Super Admin panel, e.g. you@company.com
ADMIN_EMAILS=
# Sign-in allowlist. Signing in with Google proves identity, not membership —
# the backend is public, so this is what keeps strangers out of every endpoint.
# Comma-separated domains (no "@", subdomains are NOT implied — list them).
# Leaving BOTH of these empty locks everyone out except the project owners;
# an unconfigured allowlist means "no one", not "everyone".
ALLOWED_EMAIL_DOMAINS=legalsoft.com
# Comma-separated individual addresses allowed regardless of domain
# (contractors, clients). Empty by default.
ALLOWED_EMAILS=

# --- OpenRouter (agent LLM + image generation) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Reasoning "brain" for the agent (persona, creative decision, master prompt)
OPENROUTER_MODEL=anthropic/claude-opus-4.6
# Fast model for trivial parsing (aspect ratio/brief extraction, URL guess)
OPENROUTER_FAST_MODEL=anthropic/claude-sonnet-4.5
# Premium image-output model. Flux.2 Pro = studio-grade default for ad backgrounds.
# For absolute max quality set: black-forest-labs/flux.2-max
# Other strong options: google/gemini-3-pro-image-preview, openai/gpt-5.4-image-2
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-pro
OPENROUTER_IMAGE_MODEL_HERO=black-forest-labs/flux.2-max
# Vision-capable model used for OCR on uploaded images.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

APP_PUBLIC_URL=http://localhost:3000
APP_TITLE=AgentOS

# --- Google Cloud (Firestore + Cloud Storage) ---
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
GCS_BUCKET_NAME=
# Firestore database id (use "(default)" or a named DB like "lsbrandkit").
FIRESTORE_DATABASE=(default)

# --- Canva Connect ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Note: Canva requires 127.0.0.1 (not "localhost") for local redirect URIs.
CANVA_REDIRECT_URI=http://127.0.0.1:8080/api/canva/callback

# --- Brand asset source (ingestion) ---
BRAND_KITS_DIR=C:\Users\ACER\Desktop\ghi\Data

# --- Brand Reference Library (Google Drive sync) ---
# The shared Drive folder of on-brand reference creatives, synced into the agent's
# reference library via POST /api/ref-library/sync-drive (admin button in the
# Integrations panel). Subfolders map to: Carousel->carousel, Story->social_story,
# "LS Gradients"->brand_gradient, "Newsletter Graphics"->newsletter.
# Prereqs: enable the Google Drive API on the project, and share this folder with
# the service account (GOOGLE_APPLICATION_CREDENTIALS / Cloud Run identity).
GD_DRIVE_FOLDER_ID=1-Uc5z2Rx5TlA3lRFBxDHDIpslVl3r_pG
GD_DRIVE_BRAND_NAME=Legal Soft
# Where the synced assets + index live. On Cloud Run set a writable path (e.g.
# /tmp/reference_library); locally defaults to Data/_reference_mock when unset.
# GD_REFERENCE_DIR=

# --- Marketing Research agent (a6) ---
# Multi-sheet support: users connect extra Google Sheets by pasting a link, and
# the Ask/insight layer reads them alongside the primary tracker.
#
# DEFAULT ON. Absent = "1" — it is opt-OUT, and it had never appeared in any
# config file, so the only way to learn it existed was to read
# sources_registry.py. That is why it is written down here.
#
# Setting it to 0 turns off: POST/DELETE /api/mr/sources (both answer 403) and
# every read of a secondary workbook (extra_sources() returns nothing, so
# /mr/ask, /mr/workbook and the lead-analysis tab scan see the primary tracker
# only). Already-connected sheets are NOT deleted — they stop being read and
# stay listed, so flipping it back restores them.
#
# The connected sheets are workspace-shared on purpose: every caller sees the
# whole team's list, because the agent reads them all through one shared
# service account. Disconnecting is owner-gated — you may remove what you
# connected, an admin may remove anything.
# MR_MULTI_SHEET=0
#
# The identity users must share their sheet with (Viewer). Defaults to the
# runtime credentials' own service account, so set this only when they differ.
# MR_SERVICE_ACCOUNT_EMAIL=
#
# Whose workspace the nightly sheet-pull cron runs as. Unset = the pull is
# skipped and says so.
# MR_CRON_USER_ID=
#
# Local dev only: 1 persists MR runs/config to JSON files instead of Firestore.
# The test suite sets this itself (backend/conftest.py).
# MR_OFFLINE=1

# --- SEO GEO agent (a2) ---
# Serper.dev key for SERP x-ray / keyword lab (also settable via Firestore
# app_config/global.seo_serper_api_key in prod).
SEO_SERPER_API_KEY=
# Shared secret for the SEO cron endpoint (POST /api/seo-geo/cron/run,
# x-cron-key header). Endpoint returns 503 until this is set.
SEO_CRON_KEY=

# --- GEO agent (a10 — AI answer visibility) ---
# Direct engine keys for AI-answer polling. Deliberately NOT via OpenRouter:
# citation metadata only comes from the providers' own APIs. Each key is
# optional — its engine simply stays unavailable until set (here or in
# Settings -> Secrets). Perplexity keys start "pplx-", OpenAI keys "sk-".
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Shared secret for the weekly GEO poll cron (Phase 4; endpoint fails closed).
# GEO_CRON_KEY=

# --- Browser Agent (a11 — Chrome-extension web copilot) ---
# Kill switch: 1 turns every /api/browser endpoint into an honest 403.
# BROWSER_AGENT_DISABLED=1
# Per-run LLM decision cap (default 40, clamped to 200).
# BROWSER_MAX_STEPS=40
# Comma-separated domain allow-list. Empty = everything except the blocklist.
# Subdomains match automatically (legalsoft.com covers app.legalsoft.com).
# BROWSER_ALLOWED_DOMAINS=
# Comma-separated blocklist. Defaults to banking/payment/credential domains —
# see browser_agent/actions.py DEFAULT_BLOCKED_DOMAINS. Setting this REPLACES
# the default list, so include those domains if you still want them blocked.
# BROWSER_BLOCKED_DOMAINS=
# Local-dev only: 1 persists runs to JSON files instead of Firestore.
# BROWSER_OFFLINE=1

